generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  GUEST
  STAFF
}
enum BookingStatus {
  HOLD
  CONFIRMED
  CANCELLED
  EXPIRED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}
enum EnquiryCategory {
  ROOM_BOOKING
  WEDDING
  CORPORATE_OFFSITE
  COMPLAINT
  UNSORTED
}
enum EnquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String?
  role Role @default(GUEST)
  createdAt DateTime @default(now())
  bookings Booking[]
  enquiries Enquiry[]
  auditLogs AuditLog[]
  complaintAlerts ComplaintAlert[]
}

model RoomCategory {
  id String @id @default(cuid())
  name String @unique
  description String
  capacity Int
  basePrice Int
  images Json
  amenities Json
  active Boolean @default(true)
  dailyRates DailyRate[]
  allotments WebsiteAllotment[]
  bookings Booking[]
  bookingNights BookingNight[]
}

model DailyRate {
  id String @id @default(cuid())
  roomCategoryId String
  date DateTime
  basePrice Int
  gstRate Int
  roomCategory RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  @@unique([roomCategoryId, date])
  @@index([date])
}

model WebsiteAllotment {
  id String @id @default(cuid())
  roomCategoryId String
  date DateTime
  allotment Int
  blackout Boolean @default(false)
  roomCategory RoomCategory @relation(fields: [roomCategoryId], references: [id], onDelete: Cascade)
  @@unique([roomCategoryId, date])
  @@index([date])
}

model Booking {
  id String @id @default(cuid())
  bookingReference String @unique
  idempotencyKey String? @unique
  userId String?
  roomCategoryId String
  checkIn DateTime
  checkOut DateTime
  guestCount Int
  baseAmount Int
  taxAmount Int
  totalAmount Int
  status BookingStatus @default(HOLD)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  roomCategory RoomCategory @relation(fields: [roomCategoryId], references: [id])
  hold BookingHold?
  bookingNights BookingNight[]
  payments Payment[]
  @@index([checkIn, checkOut])
}

model BookingHold {
  id String @id @default(cuid())
  bookingId String @unique
  expiresAt DateTime
  status String @default("ACTIVE")
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingNight {
  id String @id @default(cuid())
  bookingId String
  roomCategoryId String
  date DateTime
  status String @default("HELD")
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomCategory RoomCategory @relation(fields: [roomCategoryId], references: [id])
  @@unique([bookingId, date])
  @@index([roomCategoryId, date])
  @@index([date])
}

model Payment {
  id String @id @default(cuid())
  bookingId String
  amount Int
  status PaymentStatus
  transactionReference String?
  callbackKey String? @unique
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id String @id @default(cuid())
  code String @unique
  discountType String
  discountValue Int
  validFrom DateTime
  validUntil DateTime
  active Boolean @default(true)
}

model Enquiry {
  id String @id @default(cuid())
  enquiryReference String @unique
  senderName String
  email String?
  phone String?
  source String
  message String
  category EnquiryCategory
  confidence Float
  extractedData Json?
  assignedTo String?
  replyDraft String?
  status EnquiryStatus @default(OPEN)
  createdAt DateTime @default(now())
  assigned User? @relation(fields: [assignedTo], references: [id])
  messages EnquiryMessage[]
  complaintAlert ComplaintAlert?
  @@index([category, status])
}

model EnquiryMessage {
  id String @id @default(cuid())
  enquiryId String
  content String
  direction String
  createdAt DateTime @default(now())
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entityType String
  entityId String
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
}

model ComplaintAlert {
  id String @id @default(cuid())
  enquiryId String @unique
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt DateTime @default(now())
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  acknowledger User? @relation(fields: [acknowledgedBy], references: [id])
  @@index([acknowledgedAt])
}
